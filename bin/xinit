# xinit: monitor XWiki instances. See docs/DESIGN.md.
set -euo pipefail

# The libraries: $XINIT_LIB_DIR, else ../lib/xinit next to this script, which holds both in the
# source tree and once installed under a prefix (bin/ and lib/xinit/ side by side).
if [ -z "${XINIT_LIB_DIR:-}" ]; then
  _self="$(readlink -f "${BASH_SOURCE[0]}")"
  XINIT_LIB_DIR="$(cd "$(dirname "$_self")/../lib/xinit" && pwd)"
fi
# shellcheck source=../lib/xinit/core.sh
. "$XINIT_LIB_DIR/core.sh"
# shellcheck source=../lib/xinit/config.sh
. "$XINIT_LIB_DIR/config.sh"
# shellcheck source=../lib/xinit/parse.sh
. "$XINIT_LIB_DIR/parse.sh"
# shellcheck source=../lib/xinit/result.sh
. "$XINIT_LIB_DIR/result.sh"
# shellcheck source=../lib/xinit/layout.sh
. "$XINIT_LIB_DIR/layout.sh"
# shellcheck source=../lib/xinit/profiles/debian-tomcat.sh
. "$XINIT_LIB_DIR/profiles/debian-tomcat.sh"
# shellcheck source=../lib/xinit/profiles/debian-xjetty.sh
. "$XINIT_LIB_DIR/profiles/debian-xjetty.sh"
# shellcheck source=../lib/xinit/profiles/war.sh
. "$XINIT_LIB_DIR/profiles/war.sh"
# shellcheck source=../lib/xinit/check.sh
. "$XINIT_LIB_DIR/check.sh"
# shellcheck source=../lib/xinit/checks/process.sh
. "$XINIT_LIB_DIR/checks/process.sh"
# shellcheck source=../lib/xinit/checks/http.sh
. "$XINIT_LIB_DIR/checks/http.sh"
# shellcheck source=../lib/xinit/checks/rest.sh
. "$XINIT_LIB_DIR/checks/rest.sh"
# shellcheck source=../lib/xinit/checks/oom.sh
. "$XINIT_LIB_DIR/checks/oom.sh"
# shellcheck source=../lib/xinit/checks/db.sh
. "$XINIT_LIB_DIR/checks/db.sh"
# shellcheck source=../lib/xinit/checks/disk.sh
. "$XINIT_LIB_DIR/checks/disk.sh"
# shellcheck source=../lib/xinit/state.sh
. "$XINIT_LIB_DIR/state.sh"
# shellcheck source=../lib/xinit/maint.sh
. "$XINIT_LIB_DIR/maint.sh"
# shellcheck source=../lib/xinit/act.sh
. "$XINIT_LIB_DIR/act.sh"
# shellcheck source=../lib/xinit/notify.sh
. "$XINIT_LIB_DIR/notify.sh"
# shellcheck source=../lib/xinit/report.sh
. "$XINIT_LIB_DIR/report.sh"
# shellcheck source=../lib/xinit/watch.sh
. "$XINIT_LIB_DIR/watch.sh"
# shellcheck source=../lib/xinit/warmup.sh
. "$XINIT_LIB_DIR/warmup.sh"
# shellcheck source=../lib/xinit/setup.sh
. "$XINIT_LIB_DIR/setup.sh"

usage() {
  cat <<USAGE
Usage: xinit [-i <instance>] [-o KEY=value]... <command> [options]

Options, before or after the command:
  -i, --instance <name>   the instance to work on, when there are several
  -o KEY=value            override a configuration value, for this run

Commands:
  layout     show how this XWiki installation was detected
  check      run the checks (read-only)
  watch      run the checks and restart XWiki after repeated failures (--dry-run)
  report     build a diagnostics report (--output FILE, --send to mail it)
  maint      maintenance mode: on [--for DURATION] [--reason TEXT] | off | status
  setup      install the systemd units that run xinit by itself (--dry-run, --undo)
  version    print the version
  help       print this help

Run by the systemd units that 'setup' installs:
  act        as root: restart XWiki or take a thread dump, on request of 'watch'
  notify     notify that XWiki has crashed
  warmup     send the first requests to XWiki after its start
USAGE
}

# This script and its arguments, for a command that has to run again as another user.
XINIT_SELF="$(readlink -f "${BASH_SOURCE[0]}")"
XINIT_ARGV=("$@")
# The requested instance (-i), empty when not given.
OPT_INSTANCE=""
# The arguments left once the global options are taken out: the command and its own options.
ARGS=()

# parse_global_options <args...>: take -i and -o out, wherever they are, up to a "--".
parse_global_options() {
  local re_override='^[A-Za-z_][A-Za-z0-9_]*='
  while [ $# -gt 0 ]; do
    case "$1" in
      -i | --instance)
        [ $# -ge 2 ] || xinit_die "$1 needs an instance name" "$XINIT_EXIT_USAGE"
        OPT_INSTANCE="$2"
        shift 2
        ;;
      -o)
        [ $# -ge 2 ] || xinit_die "-o needs KEY=value" "$XINIT_EXIT_USAGE"
        [[ "$2" =~ $re_override ]] || xinit_die "-o $2: expected KEY=value" "$XINIT_EXIT_USAGE"
        XINIT_CLI_OVERRIDES+=("$2")
        shift 2
        ;;
      --)
        shift
        ARGS+=("$@")
        return 0
        ;;
      *)
        ARGS+=("$1")
        shift
        ;;
    esac
  done
}

main() {
  parse_global_options "$@"
  local cmd="${ARGS[0]:-help}"
  case "$cmd" in
    version | --version) echo "xinit $XINIT_VERSION" ;;
    help | --help | -h) usage ;;
    layout)
      xinit_instance_resolve "$OPT_INSTANCE"
      xinit_config_load
      xinit_cmd_layout "${ARGS[@]:1}" || exit $?
      ;;
    check)
      xinit_instance_resolve "$OPT_INSTANCE"
      xinit_config_load
      xinit_cmd_check "${ARGS[@]:1}" || exit $?
      ;;
    maint)
      xinit_instance_resolve "$OPT_INSTANCE"
      xinit_config_load
      xinit_cmd_maint "${ARGS[@]:1}" || exit $?
      ;;
    watch)
      xinit_instance_resolve "$OPT_INSTANCE"
      xinit_config_load
      xinit_cmd_watch "${ARGS[@]:1}" || exit $?
      ;;
    setup | act | notify | warmup | report)
      xinit_instance_resolve "$OPT_INSTANCE"
      xinit_config_load
      "xinit_cmd_$cmd" "${ARGS[@]:1}" || exit $?
      ;;
    *)
      usage >&2
      xinit_die "unknown command: $cmd" "$XINIT_EXIT_USAGE" ;;
  esac
}

main "$@"
