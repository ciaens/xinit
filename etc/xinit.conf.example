# xinit configuration: /etc/xinit/xinit.conf
#
# One KEY=value per line. A value is taken as written: nothing is expanded, and a # after a value
# is part of it. Quote a value with "..." or '...' to keep spaces at its ends.
#
# This file applies to every instance. /etc/xinit/instances/<name>.conf holds what differs for one
# instance; select it with `xinit -i <name>`. Any key can also be set for one run with
# `xinit -o KEY=value`, or in the environment as XINIT_<KEY>.
#
# With XWiki installed from the Debian packages, nothing has to be set: run `xinit layout` to see
# what was detected. Each line below shows a key with its default value.

# ---- Where XWiki is ---------------------------------------------------------------------------
# For a WAR deployed by hand, set UNIT, WEBAPP_DIR and BASE_URL. The rest is read from the files
# under WEBAPP_DIR.

# The kind of installation: debian-tomcat, debian-xjetty or war. Detected.
#PROFILE=
# The systemd unit that runs XWiki. Detected for the Debian packages.
#UNIT=
# The directory of the XWiki web application, which holds WEB-INF.
#WEBAPP_DIR=
# The directory of xwiki.properties and hibernate.cfg.xml. Default: WEBAPP_DIR/WEB-INF, or
# /etc/xwiki for the Debian packages.
#CONFIG_DIR=
# XWiki's permanent directory. Default: environment.permanentDirectory in xwiki.properties.
#PERMDIR=
# The URL of XWiki as seen from this host, without a trailing /. Detected for the Debian packages
# from the servlet container's configuration, for example http://localhost:8080/xwiki
#BASE_URL=
# Where XWiki logs. Default: journal:<UNIT>. Only the systemd journal is supported.
#LOG_SOURCE=
# A file holding the PID of the JVM, when the unit's main process is not the JVM itself.
#PID_FILE=

# The database. Default: read from hibernate.cfg.xml. Set these if xinit may not read that file.
# DB_TYPE is postgresql, mysql, mariadb, oracle, hsqldb...
#DB_TYPE=
#DB_HOST=
#DB_PORT=
#DB_NAME=
#DB_USER=

# ---- Checks -----------------------------------------------------------------------------------

# The checks `xinit check` runs, separated by spaces or commas.
#CHECKS=process http rest oom db disk

# Seconds after its start during which a JVM that refuses connections, or does not answer, is
# "starting" (a warning) and not a failure.
#STARTUP_GRACE=300

# http: the page to request, after BASE_URL.
#HTTP_PATH=/bin/view/Main/
# http: the status codes that mean XWiki works, separated by spaces or commas.
#HTTP_EXPECT=200
# http: seconds after which an answer is slow (a warning).
#HTTP_SLOW=10
# http: seconds after which a request is given up (a failure).
#HTTP_TIMEOUT=30
# http: yes to accept any TLS certificate, for an https BASE_URL with a self-signed certificate.
#HTTP_INSECURE=no
# http: a netrc file with the login and password to send, for a wiki that guests cannot view.
# Default: /etc/xinit/credentials/<instance>.netrc, when it exists. Keep it readable by the user
# running xinit only (chmod 600). Its content: machine <host of BASE_URL> login <user> password <password>
#HTTP_NETRC=

# oom: how far back to look in the journal for out-of-memory errors, in seconds.
#OOM_WINDOW=3600

# db: seconds to wait for the database.
#DB_TIMEOUT=10
# db: the file with the database password, to check that a login and a query work. Without it,
# only the database port is checked. Default, in /etc/xinit/credentials/:
#   <instance>.pgpass   PostgreSQL, in the format of ~/.pgpass:  host:port:database:user:password
#   <instance>.my.cnf   MySQL and MariaDB:  a [client] line, then a password=<password> line
# Keep it readable by the user running xinit only (chmod 600).
#DB_CREDENTIALS=

# disk: percentages of free space and free inodes on the file system of the permanent directory,
# below which the check warns, and fails.
#DISK_WARN=10
#DISK_CRIT=5

# ---- Restarts ---------------------------------------------------------------------------------
# `xinit watch` runs every minute. It restarts XWiki when a check of ACT_ON has been critical for
# RESTART_AFTER runs in a row. A warning, or a check that could not tell, never causes a restart.

# The checks whose critical status counts, separated by spaces or commas. Empty: never restart.
#ACT_ON=process http oom
# How many failed runs in a row before a restart.
#RESTART_AFTER=3
# How long after a restart the next one has to wait. Durations are explained below.
#COOLDOWN=15min
# At most MAX_RESTARTS restarts in MAX_RESTARTS_WINDOW. Then xinit stops restarting and says so
# once, until XWiki is healthy again.
#MAX_RESTARTS=3
#MAX_RESTARTS_WINDOW=1h
# The command that restarts XWiki, when it is not `systemctl restart UNIT`. It is split on spaces
# and run without a shell: no quotes, no variables, no pipes.
#RESTART_CMD=

# ---- Reports ----------------------------------------------------------------------------------
# `xinit report` builds one, and `xinit watch` before it restarts XWiki.

# How many reports are kept, in STATE_DIR/<instance>/reports.
#REPORT_KEEP=10
# How many lines of the log of XWiki go in a report.
#REPORT_JOURNAL_LINES=2000
# yes: a report holds the text of the queries the database is running. They may hold data of the
# wiki, and the report may leave by mail.
#REPORT_DB_QUERIES=no
# How long to wait between two of the three thread dumps of a report.
#THREADDUMP_INTERVAL=5s

# ---- Notifications ----------------------------------------------------------------------------
# What xinit does is always a line in the system log (journalctl -t xinit). A restart, restarts
# that did not help, checks that cannot tell any more, a crash and a maintenance that lasts are
# also mailed, with the report, when MAIL is set.

# Who gets the mails: addresses separated by spaces or commas. Empty: no mail.
#MAIL=
# The sender. Default: xinit@<the name of this host>.
#MAIL_FROM=
# The mail server, which curl talks to: smtp://host[:port], or smtps://host[:port] for a server
# that speaks TLS from the first byte. A host without a mail server names its relay here.
#MAIL_SMTP_URL=smtp://localhost:25
# STARTTLS on an smtp:// server. yes: required. no: never, even to log in. auto: required when
# xinit logs in, so that the password is not sent in clear.
#MAIL_SMTP_TLS=auto
# A netrc file with the login and password of the mail server, when it asks for them.
# Default: /etc/xinit/credentials/smtp.netrc, when it exists. Keep it readable by the user running
# xinit only (chmod 600). Its content: machine <host of MAIL_SMTP_URL> login <user> password <password>
#MAIL_SMTP_NETRC=
# A report larger than this, in kilobytes, is not attached to the mail. 0: never attach.
#MAIL_ATTACH_MAX=5000
# The same notification is not mailed again within this time: the next mail says how many were
# held back. The line in the system log is always written.
#NOTIFY_REPEAT=1h

# ---- What `xinit setup` installs ----------------------------------------------------------------
# Run `xinit setup` again after changing one of these.

# JVM options to add to the unit that runs XWiki, for example -Xmx4g. They are passed in
# JDK_JAVA_OPTIONS, which the java launcher reads. No double quote and no backslash.
#JVM_OPTS_APPEND=

# The first requests after each start of XWiki, separated by spaces: one per wiki of a farm. A
# path is taken under BASE_URL. Empty: the page of the http check.
#WARMUP_URLS=
# How long the first requests are tried, in all.
#WARMUP_TIMEOUT=10min

# ---- Maintenance and state --------------------------------------------------------------------

# How long `xinit maint on` lasts without --for. A duration is a number of seconds, or numbers
# with a unit: s, m or min, h, d (90, 15min, 2h, 1h30m).
#MAINT_DURATION=2h
# A maintenance that lasts is notified: first when it has lasted MAINT_REMINDER_AFTER, then every
# MAINT_REMINDER. MAINT_REMINDER=0: never. A maintenance of the default MAINT_DURATION ends before
# the first reminder.
#MAINT_REMINDER=1h
#MAINT_REMINDER_AFTER=2h

# Where xinit keeps what it has to remember, in one directory per instance.
#STATE_DIR=/var/lib/xinit
# Where xinit keeps its locks, in one directory per instance.
#RUN_DIR=/run/xinit
