#!/usr/bin/env bash

# Source global settings and Xinit configuration
if [[ -e /var/lib/xinit/vars ]]; then
    . /var/lib/xinit/vars
else
    echo "Error: No vars file was found! Exiting..."
    exit 1
fi

for lib in ${LIBS_FILE}; do
    if [[ ! -e "${LIB_DIR}/${lib}" ]]; then
        echo "Error: Could not find lib file: ${LIB_DIR}/${lib}. Exiting..."
        exit 1
    else
        . "${LIB_DIR}"/"${lib}"
    fi
done

if [[ -e ${CONF_DIR}/${XWIKI_CONF_FILE} ]]; then
    . "${CONF_DIR}"/"${XWIKI_CONF_FILE}"
else
    echo "Warning: No conf file (${CONF_DIR}/${XWIKI_CONF_FILE}) was found. Using default configuration..."
fi

if [[ ! -d ${VAR_DIR} ]]; then
    echo "Creating var folder: ${VAR_DIR}..."
    mkdir -p "${VAR_DIR}"
fi

export TOMCAT_HOME JAVA_HOME CATALINA_OPTS TOMCAT_USER LANG CATALINA_PID CONTAINER_TYPE DB_TYPE XWIKI_INSTALL_DIR

main() {
    case "$1" in
        start)
            start_container
            ;;
        stop)
            stop_container
            ;;
        restart)
            restart_container
            ;;
        status)
            check_proc
            ;;
        report)
            send_report
            ;;
        show-report)
            show_report
            ;;
        list-parameters)
            list_parameters
            ;;
        check-http)
            FORCE="$2"
            check_http
            ;;
        test-http)
            TEST_HTTP="1"
            FORCE="$2"
            check_http "${TEST_HTTP}"
            ;;
        maintenance)
            ACTION="$2"
            if [[ $ACTION =~ (check|on|off|^$) ]]; then
                maintenance "${ACTION}"
            else
                show_help
                exit 1
            fi
            ;;
        sanitycheck-db)
            run_sanitycheck_db
            ;;
        spamdetection-db)
            run_spamdetection_db
            ;;
        check-install)
            check_install
            ;;
        check-dep)
            check_dependencies
            ;;
        nagios-info)
            nagios_info
            ;;
        cronjob)
            ACTION="$2"
            if [[ ${ACTION} =~ (check|on|off|^$) ]]; then
                cronjob "${ACTION}"
            else
                show_help
                exit 1
            fi
            ;;
        version)
            echo ""
            echo " Xinit version $VERSION"
            if [[ -s "${XWIKI_INSTALL_DIR}/WEB-INF/version.properties" ]]; then
                echo " XWiki $(cat "${XWIKI_INSTALL_DIR}/WEB-INF/version.properties")"
            else
                echo " XWiki version.properties not found or empty at ${XWIKI_INSTALL_DIR}/WEB-INF/version.properties"
            fi
            echo ""
            ;;
        help)
            show_help
            ;;
        *)
            show_help
            exit 1
            ;;
    esac
}

main "$@"

# Dummy functions for now, these will be moved/refactored from /var/lib/xinit/functions
# The original functions will be sourced, but the direct calls will be within this script.
# This approach maintains compatibility with existing sourced files while centralizing control.
# The 'show_help' function will be explicitly defined or sourced to avoid issues.

show_help() {
    echo ""
    echo " Usage: xinit-manager [OPTIONS]"
    echo ""
    echo "    OPTIONS:"
    echo ""
    echo "        start            Start XWiki container (Tomcat/Jetty)."
    echo "        stop             Stop XWiki container (Tomcat/Jetty)."
    echo "        restart          Restart XWiki container (Tomcat/Jetty)."
    echo "        status           Check XWiki container (Tomcat/Jetty) process status."
    echo "        report           Send report by email. See MAIL parameter in xinit.cfg"
    echo "        show-report      Print a short report about xwiki/machine status."
    echo "        list-parameters  Print all available parameters and current configuration."
    echo "        check-http [force] Check if the wiki is responding or not. Use force to skip CHECK_HTTP=no"
    echo "        test-http [force] Just test if check-http works. No notifications or restart will be performed. Use force to skip CHECK_HTTP=no"
    echo "        maintenance [on|off|check] Enable/disable Maintenance mode. In this mode, check_proc or http won't restart the wiki until disabled."
    echo "        sanitycheck-db   Run a sanity check upon database configured in xinit.cfg file."
    echo "        spamdetection-db Run a spam check to detect pages with huge number of comments."
    echo "        check-install    Check XWiki installation (based on standard installation)."
    echo "        check-dep        Check all the dependencies commands Xinit needs to run."
    echo "        nagios-info      Informations needed for Nagios to check XWiki availability will be printed."
    echo "        cronjob [on|off|check] Enable/disable cronjobs checks managing automatic restarts."
    echo "        version          Print Xinit and XWiki version."
    echo "        help             Show this help message."
    echo ""
}
