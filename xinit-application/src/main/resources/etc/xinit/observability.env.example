# XInit observability env-file template.
#
# Copy to /etc/xinit/observability.env, edit the values, and reference it
# from xinit.cfg via:
#
#     EXTRA_ENVIRONMENT_FILES="/etc/xinit/observability.env"
#
# Then re-run:  xinit setup-systemd && systemctl daemon-reload && systemctl restart <unit>
#
# Format: pure systemd EnvironmentFile syntax.
#   - One KEY=VALUE per line.
#   - NO `export` keyword.
#   - NO shell substitution (`$(hostname)`, `${OTHER_VAR}`, etc.).
#   - NO systemd specifiers (`%H`, `%h`, ...). Specifiers only work in
#     Environment= lines inside a unit/drop-in, not in EnvironmentFile.
#     For hostname-derived values, write a small hand-managed drop-in at
#     /etc/systemd/system/<unit>.d/99-host.conf containing e.g.:
#         [Service]
#         Environment="OTEL_RESOURCE_ATTRIBUTES=service.namespace=xwiki,service.instance.id=%H,deployment.environment=production"
#
# Lines starting with `#` are comments. Blank lines are ignored.

###############
# OpenTelemetry
###############
OTEL_SERVICE_NAME=xwiki
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none
OTEL_BSP_MAX_QUEUE_SIZE=4096
OTEL_SPAN_ATTRIBUTE_VALUE_LENGTH_LIMIT=4096
OTEL_INSTRUMENTATION_COMMON_DB_STATEMENT_SANITIZER_ENABLED=true
OTEL_INSTRUMENTATION_COMMON_ENDUSER_ENABLED=true
# Comma-separated additional OTEL agent extension jars:
#OTEL_JAVAAGENT_EXTENSIONS=/opt/otel/pyroscope-otel.jar

###########
# Pyroscope
###########
PYROSCOPE_APPLICATION_NAME=xwiki
PYROSCOPE_SERVER_ADDRESS=http://127.0.0.1:4040
PYROSCOPE_PROFILER_EVENT=wall
PYROSCOPE_PROFILER_ALLOC=2m
PYROSCOPE_PROFILER_LOCK=1ms
PYROSCOPE_UPLOAD_INTERVAL=2s
PYROSCOPE_PROFILER_ARGS=features=vtable

##########
# Glowroot
##########
# Glowroot is normally configured via -javaagent:glowroot.jar=-Dkey=value
# pairs in JVM_AGENTS (see xinit.cfg). The few env vars it honours go here.
#GLOWROOT_LOG_DIR=/var/log/glowroot
