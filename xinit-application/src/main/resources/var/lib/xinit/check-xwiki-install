#!/usr/bin/env bash

check_install ()
{
    log "INFO" "Starting installation check for ${CONTAINER_TYPE} ${CONTAINER_VERSION}"
    check_xwiki
    check_container
    check_java
    check_database
    check_systemd
}

check_xwiki ()
{
    if [[ ! -d "${XWIKI_INSTALL_DIR}" ]]; then
        log "WARNING" "XWiki directory not found at ${XWIKI_INSTALL_DIR}"
        return
    fi

    if [[ ! -f "${XWIKI_INSTALL_DIR}/WEB-INF/xwiki.cfg" ]]; then
        log "WARNING" "xwiki.cfg not found in ${XWIKI_INSTALL_DIR}/WEB-INF/"
        return
    fi

    if ! grep -q "xwiki.encoding.*=.*UTF-8" "${XWIKI_INSTALL_DIR}/WEB-INF/xwiki.cfg"; then
        log "WARNING" "xwiki.cfg may not be configured for UTF-8 encoding"
    fi

    if [[ -f "${XWIKI_INSTALL_DIR}/WEB-INF/hibernate.cfg.xml" ]]; then
        if ! grep -q 'connection.useUnicode">true' "${XWIKI_INSTALL_DIR}/WEB-INF/hibernate.cfg.xml"; then
            log "WARNING" "hibernate.cfg.xml may not be configured for UTF-8 encoding"
        fi
    fi

    log "INFO" "XWiki installation check passed"
}

check_container ()
{
    case "${CONTAINER_TYPE}" in
        "jetty")
            if [[ ! -d "${CONTAINER_HOME}" ]]; then
                log "WARNING" "Jetty home not found at ${CONTAINER_HOME}"
                return
            fi
            if [[ ! -f "${START_SCRIPT}" ]]; then
                log "WARNING" "Jetty start script not found at ${START_SCRIPT}"
                return
            fi
            log "INFO" "Jetty installation check passed"
            ;;
        "tomcat")
            if [[ ! -d "${CONTAINER_HOME}" ]]; then
                log "WARNING" "Tomcat home not found at ${CONTAINER_HOME}"
                return
            fi
            if [[ ! -f "${CONTAINER_HOME}/bin/catalina.sh" ]]; then
                log "WARNING" "catalina.sh not found in ${CONTAINER_HOME}/bin/"
                return
            fi
            if [[ -f "${CONTAINER_HOME}/conf/server.xml" ]] && ! grep -q 'URIEncoding.*=.*"UTF-8"' "${CONTAINER_HOME}/conf/server.xml"; then
                log "WARNING" "Tomcat may not be configured for UTF-8 encoding in server.xml"
            fi
            log "INFO" "Tomcat installation check passed"
            ;;
    esac
}

check_systemd ()
{
    if ! systemctl list-unit-files | grep -q "^${SERVICE_NAME}"; then
        log "WARNING" "Systemd service ${SERVICE_NAME} not found"
        log "WARNING" "Run 'xinit setup-systemd' to create configuration"
        return
    fi

    log "INFO" "Systemd service check passed: ${SERVICE_NAME}"
}

check_java ()
{
    if [[ -z "${JAVA_HOME}" ]] || [[ ! -d "${JAVA_HOME}" ]]; then
        log "WARNING" "JAVA_HOME not set or directory not found: ${JAVA_HOME}"
        return
    fi

    if [[ ! -x "${JAVA_HOME}/bin/java" ]]; then
        log "WARNING" "Java executable not found at ${JAVA_HOME}/bin/java"
        return
    fi

    local java_version=$("${JAVA_HOME}/bin/java" -version 2>&1 | head -n 1)
    log "INFO" "Java check passed: ${java_version}"
}

check_database ()
{
    case "${DB_TYPE}" in
        "mysql")
            if ! command -v mysql &>/dev/null; then
                log "WARNING" "MySQL client not found"
                return
            fi

            if ! mysql -u"${MYSQL_USER}" --password="${MYSQL_PASSWORD}" -h"${MYSQL_HOST}" -e "SELECT 1;" &>/dev/null; then
                log "WARNING" "Cannot connect to MySQL/MariaDB with configured credentials"
                return
            fi

            log "INFO" "MySQL/MariaDB connection check passed (user: ${MYSQL_USER})"
            ;;
        "pgsql")
            if ! command -v psql &>/dev/null; then
                log "WARNING" "PostgreSQL client not found"
                return
            fi

            if ! PGPASSWORD="${PGSQL_PASSWORD}" psql -U "${PGSQL_USER}" -h "${PGSQL_HOST}" -p "${PGSQL_PORT}" -d "${PGSQL_DATABASE}" -c "SELECT 1;" &>/dev/null; then
                log "WARNING" "Cannot connect to PostgreSQL with configured credentials"
                return
            fi

            log "INFO" "PostgreSQL connection check passed (user: ${PGSQL_USER})"
            ;;
        "none")
            log "INFO" "No database configured (DB_TYPE=none)"
            ;;
    esac
}