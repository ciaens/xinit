log ()
{
	local severity="$1"
	local message="$2"
	local _date
	local _time
	_date="$(date +%d-%m-%Y)"
	_time="$(date +%T)"

	echo "${_date} ${_time} [${severity}]: ${message}" >> "${LOG_FILE}"
	echo "${message}"
}

send_Notification ()
{
	local message="$1"

	get_info

        MemoryPrefix=''
        if [[ ${OOMKillerFound} != 0 ]]; then
                MemoryPrefix="[OOM KILLER]"
        elif [[ ${HeapSpaceFound} != 0 ]]; then
                MemoryPrefix="[Low Heap - ${MEM_MAX}]"
        elif [[ ${PermgenSpaceFound} != 0 ]]; then
                MemoryPrefix="[Low Permgen - ${MAX_PERM_SIZE}]"
        fi

	if [[ ${SEND_MAIL_NOTIFICATION} == yes ]]; then
		if [[ -z ${MAIL} ]]; then
			log "WARNING" "No email address was set. Please see MAIL parameter."
		else
			send_Mail "${message}"
		fi
        fi

        if [[ ${SEND_JABBER_MESSAGE} == yes ]]; then

        	send_Jabber_Message "${message}"

        fi

}

get_info ()
{

	log "INFO" "Getting infos to send notification!"

	echo "#####SECTION SERVER_NAME#####" > "${ATTACHE_FILE}"
	echo "" >> "${ATTACHE_FILE}"

	if [[ -n "${SERVER_NAME}" ]]; then

		echo "${SERVER_NAME}" >> "${ATTACHE_FILE}"

	else

		hostname | cut -d"." -f 1 >> "${ATTACHE_FILE}"

	fi
	echo "" >> "${ATTACHE_FILE}"

	echo "#####SECTION FULL_SERVER_INFO#####" >> "${ATTACHE_FILE}"
	echo "" >> "${ATTACHE_FILE}"
	uname -a >> "${ATTACHE_FILE}"
    echo "" >> "${ATTACHE_FILE}"

	echo "#####SECTION XWIKI_VERSION#####" >> "${ATTACHE_FILE}"
	echo "" >> "${ATTACHE_FILE}"
	if [[ -s ${XWIKI_INSTALL_DIR}/WEB-INF/version.properties ]]; then

		cut -d "=" -f 2 "${XWIKI_INSTALL_DIR}"/WEB-INF/version.properties  >> "${ATTACHE_FILE}"

	else

		echo "${XWIKI_INSTALL_DIR}/WEB-INF/version.properties file not found or file size = 0" >> "${ATTACHE_FILE}"

	fi
	echo "" >> "${ATTACHE_FILE}"

	echo "#####SECTION XINIT_VERSION#####" >> "${ATTACHE_FILE}"
    echo "" >> "${ATTACHE_FILE}"

	grep "VERSION" /var/lib/xinit/vars | cut -d "=" -f2 >> "${ATTACHE_FILE}"

	echo "" >> "${ATTACHE_FILE}"

	echo "#####SECTION IP_ADDRESSES#####" >> "${ATTACHE_FILE}"
	echo "" >> "${ATTACHE_FILE}"

	/sbin/ifconfig | grep inet | tr -s ' ' | cut -d " " -f1,2,3 >> "${ATTACHE_FILE}"
	echo "" >> "${ATTACHE_FILE}"

	echo "#####SECTION CONNECTION_TYPE_STATUS#####" >> "${ATTACHE_FILE}"
    echo "" >> "${ATTACHE_FILE}"

	for port in ${CONNECTION_STATE_PORTS}; do

		echo "Port: ${port}" >> "${ATTACHE_FILE}"
		netstat -tn | grep -E "^tcp.*:$port" | tr -s " " | cut -d " " -f6 | sort | uniq -c >> "${ATTACHE_FILE}"
		echo "" >> "${ATTACHE_FILE}"

	done

	echo "#####SECTION CONNECTION_APACHE_STATUS#####" >> "${ATTACHE_FILE}"
	echo "" >> "${ATTACHE_FILE}"
	curl http://127.0.0.1/server-status | sed -n '/^$/!{s/<[^>]*>/ /g;p;}' >> "${ATTACHE_FILE}"

	echo "#####SECTION DISK_USAGE#####" >> "${ATTACHE_FILE}"
    echo "" >> "${ATTACHE_FILE}"

	df -h >> "${ATTACHE_FILE}"
	echo "" >> "${ATTACHE_FILE}"

	if [[ "${DB_TYPE}" == "mysql" ]] && which mysql >/dev/null ; then
        echo "#####SECTION DATABASES_DISK_USAGE#####" >> "${ATTACHE_FILE}"
        echo "" >> "${ATTACHE_FILE}"

	    DBS="$(mysql --user="${MYSQL_USER}" --password="${MYSQL_PASSWORD}" --host="${MYSQL_HOST}" -e "show databases;" | grep -E -v "(Database|information_schema)")"

        if [ -d "/var/lib/mysql" ] ; then
            if [[ "${UID}" -eq 0 ]] ; then
                for db in ${DBS}; do
                    du -sh /var/lib/mysql/"${db}" >> "${ATTACHE_FILE}"
                done
                echo "" >> "${ATTACHE_FILE}"
            fi
        fi
    elif [[ "${DB_TYPE}" == "pgsql" ]] && which psql >/dev/null ; then
         echo "#####SECTION DATABASES_DISK_USAGE#####" >> "${ATTACHE_FILE}"
         echo "" >> "${ATTACHE_FILE}"
         PGPASSWORD="${PGSQL_PASSWORD}" psql -U "${PGSQL_USER}" -h "${PGSQL_HOST}" -p "${PGSQL_PORT}" -c "SELECT pg_database.datname, pg_size_pretty(pg_database_size(pg_database.datname)) AS size FROM pg_database ORDER BY pg_database_size(pg_database.datname) DESC;" >> "${ATTACHE_FILE}"
         echo "" >> "${ATTACHE_FILE}"
    fi

	echo "#####SECTION JAVA_THREADS_NUMBER#####" >> "${ATTACHE_FILE}"
    echo "" >> "${ATTACHE_FILE}"

	echo "Java Threads Number: $(ps -L -C java | wc -l)" >> "${ATTACHE_FILE}"
    echo "" >> "${ATTACHE_FILE}"

	echo "#####SECTION TOP_INFORMATION#####" >> "${ATTACHE_FILE}"
	echo "" >> "${ATTACHE_FILE}"

	PIDS=""

	for daemon in ${DAEMONS_TO_MONITOR} ; do

	        if [[ $(pidof "${daemon}") ]]; then
	                PIDS="${PIDS} $(pidof "${daemon}")"
	        fi

	done

	pids_top_format="$(echo "${PIDS}" | sed 's/ //1' | sed 's/ /,/g')"

	top -b -n 3 -d 0.5 -p"${pids_top_format}" >> "${ATTACHE_FILE}"
	echo "" >> "${ATTACHE_FILE}"

	echo "#####SECTION DB_FULL_PROCESS_LIST#####" >> "${ATTACHE_FILE}"
    echo "" >> "${ATTACHE_FILE}"

	if [[ "${DB_TYPE}" == "mysql" ]] && [[ $(which mysql) ]]; then
		mysql --user="${MYSQL_USER}" --password="${MYSQL_PASSWORD}" --host="${MYSQL_HOST}" -e "show full processlist;" >> "${ATTACHE_FILE}"
    elif [[ "${DB_TYPE}" == "pgsql" ]] && [[ $(which psql) ]]; then
        PGPASSWORD="${PGSQL_PASSWORD}" psql -U "${PGSQL_USER}" -h "${PGSQL_HOST}" -p "${PGSQL_PORT}" -d "${PGSQL_DATABASE}" -c "SELECT pid, usename, datname, application_name, client_addr, state, query FROM pg_stat_activity WHERE datname = '${PGSQL_DATABASE}';" >> "${ATTACHE_FILE}"
	else
		log "WARNING" "Database client not found or DB_TYPE=${DB_TYPE}"
		echo "Couldn't find db client binary" >> "${ATTACHE_FILE}"
	fi
	echo "" >> "${ATTACHE_FILE}"

	echo "#####SECTION HTTP_OUTPUT#####" >> "${ATTACHE_FILE}"
	echo "" >> "${ATTACHE_FILE}"

	cat "${REQUEST_ERROR_OUTPUT}" >> "${ATTACHE_FILE}"

	echo "" >> "${ATTACHE_FILE}"

#	Provide a DNS trace if the DIG command exists
	if [[ ${EXIT_CODE} -eq 6 ]]; then
		if [[ ${USE_DNS} == yes ]]; then
			DIG=$(which dig)
			if [[ $? -eq 0 ]]; then
				echo "#####SECTION DNS_TRACE#####" >> "${ATTACHE_FILE}"
				echo "" >> "${ATTACHE_FILE}"
				DOMAIN=$(echo "${CHECK_HTTP_URL}" | sed -r -e 's/https?:\/\/([^\/]+).*/\1/')
				$DIG +trace "${DOMAIN}" >> "${ATTACHE_FILE}"
				echo "" >> "${ATTACHE_FILE}"
			fi
		fi
	fi

	echo "#####SECTION CONTAINER_LOGS#####" >> "${ATTACHE_FILE}"
    echo "" >> "${ATTACHE_FILE}"

    HeapSpaceFound=0
    PermgenSpaceFound=0
    OOMKillerFound=0

    if systemctl is-active --quiet "${SERVICE_NAME}" 2>/dev/null; then
        LAST_LOG_LINES="$(journalctl -u "${SERVICE_NAME}" -n "${LOG_LINE_NUMBER}" --no-pager | tee -a "${ATTACHE_FILE}")"
    else
        if [[ "${CONTAINER_TYPE}" == "jetty" ]]; then
            if [[ -f "${LOG_DIR}/xwiki.log" ]]; then
                LAST_LOG_LINES="$(tail -n "${LOG_LINE_NUMBER}" "${LOG_DIR}"/xwiki.log | tee -a "${ATTACHE_FILE}")"
            elif [[ -f "${CONTAINER_HOME}/logs/xwiki.log" ]]; then
                LAST_LOG_LINES="$(tail -n "${LOG_LINE_NUMBER}" "${CONTAINER_HOME}"/logs/xwiki.log | tee -a "${ATTACHE_FILE}")"
            fi
        elif [[ "${CONTAINER_TYPE}" == "tomcat" ]]; then
            if [[ -f "${LOG_DIR}/catalina.out" ]]; then
                LAST_LOG_LINES="$(tail -n "${LOG_LINE_NUMBER}" "${LOG_DIR}"/catalina.out | tee -a "${ATTACHE_FILE}")"
            fi
        fi
    fi

    if [[ $? == 0 ]]; then
        if grep -q -F "java.lang.OutOfMemoryError: Java heap space" <<< "${LAST_LOG_LINES}"; then
            HeapSpaceFound=1
        elif grep -q -F "java.lang.OutOfMemoryError: PermGen space" <<< "${LAST_LOG_LINES}"; then
            PermgenSpaceFound=1
        fi
    fi

    echo "" >> "${ATTACHE_FILE}"
    echo "#####SECTION OOM_KILLER_CHECK#####" >> "${ATTACHE_FILE}"
    echo "" >> "${ATTACHE_FILE}"

    local oom_check_lines=""
    if command -v journalctl &>/dev/null; then
        oom_check_lines=$(journalctl -k -n 1000 --no-pager 2>/dev/null | grep -E "oom-kill|oom_reaper|Out of memory.*Kill process|Killed process.*java" || true)
    fi

    if [[ -z "${oom_check_lines}" ]] && [[ -r /var/log/kern.log ]]; then
        oom_check_lines=$(tail -n 1000 /var/log/kern.log 2>/dev/null | grep -E "oom-kill|oom_reaper|Out of memory.*Kill process|Killed process.*java" || true)
    fi

    if [[ -z "${oom_check_lines}" ]] && command -v dmesg &>/dev/null; then
        oom_check_lines=$(dmesg -T 2>/dev/null | tail -n 1000 | grep -E "oom-kill|oom_reaper|Out of memory.*Kill process|Killed process.*java" || true)
    fi

    if [[ -n "${oom_check_lines}" ]]; then
        OOMKillerFound=1
        echo "WARNING: OOM Killer activity detected!" >> "${ATTACHE_FILE}"
        echo "" >> "${ATTACHE_FILE}"
        echo "${oom_check_lines}" | tail -n 20 >> "${ATTACHE_FILE}"
        echo "" >> "${ATTACHE_FILE}"
        log "WARNING" "OOM Killer activity detected in system logs"
    else
        echo "No OOM Killer activity detected in recent system logs" >> "${ATTACHE_FILE}"
        echo "" >> "${ATTACHE_FILE}"
    fi

	echo "" >> "${ATTACHE_FILE}"

	echo "#####SECTION KILL_QUIT#####" >> "${ATTACHE_FILE}"

        echo "" >> "${ATTACHE_FILE}"

        if [[ "${CONTAINER_TYPE}" == "tomcat" ]] && [[ -e "${LOG_DIR}/catalina.out" ]]; then
            PREKILL_LOG_NUMBER="$(wc -l "${LOG_DIR}"/catalina.out | awk '{print $1}')"

            local java_pid
            java_pid=$(get_container_pid)
            if [[ -n "${java_pid}" ]]; then
                kill -3 "${java_pid}"
                sleep "${KILL_QUIT_TIME_WAIT:-4}"

                POSTKILL_LOG_NUMBER="$(wc -l "${LOG_DIR}"/catalina.out | awk '{print $1}')"
                KILLQUIT_LOG_LINES="$((POSTKILL_LOG_NUMBER - PREKILL_LOG_NUMBER))"

                if [[ -n "${THREADDUMP_ANALYSIS}" ]]; then
                    tail -n ${KILLQUIT_LOG_LINES} "${LOG_DIR}"/catalina.out > "${THREADDUMP_ANALYSIS_FILE}"
                    echo "*** Thread Dump Analysis ***" >> "${ATTACHE_FILE}"
                    eval "${THREADDUMP_ANALYSIS}" >> "${ATTACHE_FILE}"
                    echo "" >> "${ATTACHE_FILE}"
                fi

                tail -n ${KILLQUIT_LOG_LINES} "${LOG_DIR}"/catalina.out | tee -a "${ATTACHE_FILE}" | grep \"http:// | cut -d' ' -f1 | uniq -c >> "${ATTACHE_FILE}"
            fi
        else
            echo "Thread dump: ${CONTAINER_TYPE} logs collected via journalctl or ${LOG_DIR}" >> "${ATTACHE_FILE}"
        fi
}

send_Mail ()
{
	local short_message="$1"

	if [[ -n "${SERVER_NAME}" ]]; then
		local HOSTNAME_SUBJECT="${SERVER_NAME}"
	else
	    local HOSTNAME_SUBJECT
		HOSTNAME_SUBJECT="$(hostname | cut -d"." -f 1)"
	fi

	if [[ ! -e "$(which mailx)" ]]; then

		log "ERROR" "Unable to find mailx binary file! No mails will be send! Log file will be used!"

		echo "${HOSTNAME_SUBJECT}: ${MemoryPrefix} ${short_message}" >> "${LOG_FILE}"
		cat "${ATTACHE_FILE}" >> "${LOG_FILE}"
	else

		log "INFO" "Sending mail notification (${HOSTNAME_SUBJECT}): ${short_message}"

		local wrapped_file="/var/tmp/xinit_mail_wrapped.$$"
		if command -v fold &>/dev/null; then
			fold -s -w 900 "${ATTACHE_FILE}" > "${wrapped_file}"
			mailx -s "${HOSTNAME_SUBJECT}: ${MemoryPrefix} ${short_message}" "${MAIL}" < "${wrapped_file}"
			rm -f "${wrapped_file}"
		else
			mailx -s "${HOSTNAME_SUBJECT}: ${MemoryPrefix} ${short_message}" "${MAIL}" < "${ATTACHE_FILE}"
		fi

	fi

}

send_report ()
{
	log "INFO" "Sending report by email to ${MAIL}"

	get_info
	send_Mail "Xinit REPORT"
}

send_Jabber_Message ()
{

	local short_message="$1"

	if [[ ! -e "$(which sendxmpp)" ]]; then

		log "ERROR" "sendxmpp file was not found! No notifications will be send on jabber!"

	else
		log "INFO" "Sending jabber message ($(hostname)): ${short_message}"
		local ips
		ips="$(/sbin/ifconfig | grep inet | tr -s ' ' | cut -d " " -f1,2,3)"
		local load
		load="$(uptime)"
		echo -e "${short_message} \n ****IPs**** \n ${ips} \n ****LOAD**** \n ${load}" | sendxmpp -r "$(hostname)" "${JABBER_USERS}"

	fi

}

show_report ()
{
	log "INFO" "Showing report ..."

	get_info

	if [[ $(which less) ]]; then

		less "${ATTACHE_FILE}"

	elif [[ $(which more) ]]; then

		more "${ATTACHE_FILE}"

	else

		cat "${ATTACHE_FILE}"
	fi

	echo ""
