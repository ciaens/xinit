#!/usr/bin/env bash

require_systemd ()
{
    if ! command -v systemctl &>/dev/null; then
        log "ERROR" "systemd is required for xinit 2.0 but was not found"
        echo "Xinit 2.0 requires systemd to be available."
        echo "Please ensure you are running on a systemd-based system (Debian 12/13, Ubuntu 20.04+, etc.)"
        exit 1
    fi
}

detect_container_type ()
{
    if [[ -n "${CONTAINER_TYPE}" ]] && [[ "${CONTAINER_TYPE}" != "auto" ]]; then
        [[ "${VERBOSE_DETECTION}" == "true" ]] && log "INFO" "Container type explicitly set to: ${CONTAINER_TYPE}"
        return 0
    fi

    [[ "${VERBOSE_DETECTION}" == "true" ]] && log "INFO" "Auto-detecting container type..."

    if command -v dpkg &>/dev/null; then
        if dpkg -l 2>/dev/null | grep -q "^ii.*xwiki-jetty"; then
            CONTAINER_TYPE="jetty"
            CONTAINER_VERSION=$(dpkg -l 2>/dev/null | grep "^ii.*xwiki-jetty" | head -n1 | awk '{print $3}' | cut -d'-' -f1 | cut -d'+' -f1)
            [[ -z "${CONTAINER_VERSION}" ]] && CONTAINER_VERSION="package"
            [[ "${VERBOSE_DETECTION}" == "true" ]] && log "INFO" "Detected Jetty via package (version: ${CONTAINER_VERSION})"
            return 0
        elif dpkg -l 2>/dev/null | grep -q "^ii.*tomcat10"; then
            CONTAINER_TYPE="tomcat"
            CONTAINER_VERSION="10"
            [[ "${VERBOSE_DETECTION}" == "true" ]] && log "INFO" "Detected Tomcat 10 via package"
            return 0
        elif dpkg -l 2>/dev/null | grep -q "^ii.*tomcat9"; then
            CONTAINER_TYPE="tomcat"
            CONTAINER_VERSION="9"
            [[ "${VERBOSE_DETECTION}" == "true" ]] && log "INFO" "Detected Tomcat 9 via package"
            return 0
        fi
    fi

    if [[ -d "/usr/lib/xwiki-jetty" ]] && [[ -f "/usr/lib/xwiki-jetty/start_xwiki.sh" ]]; then
        CONTAINER_TYPE="jetty"
        CONTAINER_VERSION="filesystem"
        [[ "${VERBOSE_DETECTION}" == "true" ]] && log "INFO" "Detected Jetty via filesystem"
        return 0
    elif [[ -d "/usr/share/tomcat10" ]]; then
        CONTAINER_TYPE="tomcat"
        CONTAINER_VERSION="10"
        [[ "${VERBOSE_DETECTION}" == "true" ]] && log "INFO" "Detected Tomcat 10 via filesystem"
        return 0
    elif [[ -d "/usr/share/tomcat9" ]]; then
        CONTAINER_TYPE="tomcat"
        CONTAINER_VERSION="9"
        [[ "${VERBOSE_DETECTION}" == "true" ]] && log "INFO" "Detected Tomcat 9 via filesystem"
        return 0
    elif [[ -n "${TOMCAT_HOME}" ]] && [[ -d "${TOMCAT_HOME}" ]]; then
        CONTAINER_TYPE="tomcat"
        CONTAINER_VERSION="unknown"
        [[ "${VERBOSE_DETECTION}" == "true" ]] && log "INFO" "Detected Tomcat via TOMCAT_HOME"
        return 0
    fi

    if pgrep -f "start_xwiki.sh" >/dev/null 2>&1; then
        CONTAINER_TYPE="jetty"
        CONTAINER_VERSION="unknown"
        [[ "${VERBOSE_DETECTION}" == "true" ]] && log "INFO" "Detected Jetty via running process"
        return 0
    elif pgrep -f "catalina" >/dev/null 2>&1; then
        CONTAINER_TYPE="tomcat"
        CONTAINER_VERSION="unknown"
        [[ "${VERBOSE_DETECTION}" == "true" ]] && log "INFO" "Detected Tomcat via running process"
        return 0
    fi

    [[ "${VERBOSE_DETECTION}" == "true" ]] && log "WARNING" "Unable to auto-detect container type, defaulting to tomcat"
    CONTAINER_TYPE="tomcat"
    CONTAINER_VERSION="unknown"
}

resolve_container_paths ()
{
    case "${CONTAINER_TYPE}" in
        "jetty")
            CONTAINER_HOME="${JETTY_HOME:-/usr/lib/xwiki-jetty}"
            CONTAINER_BASE="${JETTY_BASE:-/usr/lib/xwiki-jetty}"
            CONTAINER_USER="${JETTY_USER:-xwiki}"
            CONTAINER_GROUP="${JETTY_USER:-xwiki}"
            DATA_DIR="/var/lib/xwiki"
            LOG_DIR="/var/log/xwiki"
            SERVICE_NAME="xwiki.service"

            LOCK_FILE="${CONTAINER_HOME}/tmp/xwiki-${JETTY_PORT:-8080}.lck"
            START_SCRIPT="${CONTAINER_HOME}/start_xwiki.sh"
            STOP_SCRIPT="${CONTAINER_HOME}/stop_xwiki.sh"

            [[ -z "${XWIKI_INSTALL_DIR}" ]] && XWIKI_INSTALL_DIR="/var/lib/xwiki"
            ;;

        "tomcat")
            if [[ "${CONTAINER_VERSION}" == "10" ]]; then
                CONTAINER_HOME="${TOMCAT_HOME:-/usr/share/tomcat10}"
                CONTAINER_BASE="${TOMCAT_BASE:-/var/lib/tomcat10}"
                LOG_DIR="/var/log/tomcat10"
                SERVICE_NAME="tomcat10.service"
            elif [[ "${CONTAINER_VERSION}" == "9" ]]; then
                CONTAINER_HOME="${TOMCAT_HOME:-/usr/share/tomcat9}"
                CONTAINER_BASE="${TOMCAT_BASE:-/var/lib/tomcat9}"
                LOG_DIR="/var/log/tomcat9"
                SERVICE_NAME="tomcat9.service"
            else
                CONTAINER_HOME="${TOMCAT_HOME:-/usr/local/tomcat}"
                CONTAINER_BASE="${TOMCAT_HOME:-/usr/local/tomcat}"
                LOG_DIR="${CONTAINER_HOME}/logs"
                SERVICE_NAME="xwiki.service"
            fi

            CONTAINER_USER="${TOMCAT_USER:-tomcat}"
            CONTAINER_GROUP="${TOMCAT_USER:-tomcat}"
            DATA_DIR="/var/lib/xwiki"
            CATALINA_PID="${CATALINA_PID:-/var/tmp/catalina.pid}"
            START_SCRIPT="${CONTAINER_HOME}/bin/catalina.sh start"
            STOP_SCRIPT="${CONTAINER_HOME}/bin/catalina.sh stop"

            [[ -z "${XWIKI_INSTALL_DIR}" ]] && XWIKI_INSTALL_DIR="${CONTAINER_BASE}/webapps/xwiki"
            ;;
    esac

    if [[ -z "${JAVA_HOME}" ]] || [[ ! -d "${JAVA_HOME}" ]]; then
        if [[ -L "/usr/lib/jvm/default-java" ]]; then
            JAVA_HOME="/usr/lib/jvm/default-java"
        elif [[ -d "/usr/lib/jvm/java-17-openjdk-amd64" ]]; then
            JAVA_HOME="/usr/lib/jvm/java-17-openjdk-amd64"
        elif [[ -d "/usr/lib/jvm/java-11-openjdk-amd64" ]]; then
            JAVA_HOME="/usr/lib/jvm/java-11-openjdk-amd64"
        fi
    fi

    export CONTAINER_TYPE CONTAINER_VERSION CONTAINER_HOME CONTAINER_BASE
    export CONTAINER_USER CONTAINER_GROUP LOG_DIR DATA_DIR SERVICE_NAME
    export XWIKI_INSTALL_DIR JAVA_HOME

    if [[ "${VERBOSE_DETECTION}" == "true" ]]; then
        log "INFO" "Container: ${CONTAINER_TYPE} ${CONTAINER_VERSION}"
        log "INFO" "Home: ${CONTAINER_HOME}"
        log "INFO" "User: ${CONTAINER_USER}"
        log "INFO" "Service: ${SERVICE_NAME}"
    fi
}

detect_database_type ()
{
    if [[ -n "${DB_TYPE}" ]] && [[ "${DB_TYPE}" != "auto" ]]; then
        [[ "${VERBOSE_DETECTION}" == "true" ]] && log "INFO" "Database type explicitly set to: ${DB_TYPE}"
        extract_database_credentials
        return 0
    fi

    [[ "${VERBOSE_DETECTION}" == "true" ]] && log "INFO" "Auto-detecting database type..."

    if command -v dpkg &>/dev/null; then
        if dpkg -l 2>/dev/null | grep -q "^ii.*xwiki-mariadb-common"; then
            DB_TYPE="mysql"
            [[ "${VERBOSE_DETECTION}" == "true" ]] && log "INFO" "Detected MariaDB via xwiki-mariadb-common package"
            extract_database_credentials
            return 0
        elif dpkg -l 2>/dev/null | grep -q "^ii.*xwiki-mysql-common"; then
            DB_TYPE="mysql"
            [[ "${VERBOSE_DETECTION}" == "true" ]] && log "INFO" "Detected MySQL via xwiki-mysql-common package"
            extract_database_credentials
            return 0
        elif dpkg -l 2>/dev/null | grep -q "^ii.*xwiki-postgresql-common"; then
            DB_TYPE="pgsql"
            [[ "${VERBOSE_DETECTION}" == "true" ]] && log "INFO" "Detected PostgreSQL via xwiki-postgresql-common package"
            extract_database_credentials
            return 0
        elif dpkg -l 2>/dev/null | grep -q "^ii.*mariadb-server"; then
            DB_TYPE="mysql"
            [[ "${VERBOSE_DETECTION}" == "true" ]] && log "INFO" "Detected MariaDB via mariadb-server package"
            extract_database_credentials
            return 0
        elif dpkg -l 2>/dev/null | grep -q "^ii.*mysql-server"; then
            DB_TYPE="mysql"
            [[ "${VERBOSE_DETECTION}" == "true" ]] && log "INFO" "Detected MySQL via mysql-server package"
            extract_database_credentials
            return 0
        elif dpkg -l 2>/dev/null | grep -q "^ii.*postgresql"; then
            DB_TYPE="pgsql"
            [[ "${VERBOSE_DETECTION}" == "true" ]] && log "INFO" "Detected PostgreSQL via postgresql package"
            extract_database_credentials
            return 0
        fi
    fi

    if command -v mysql &>/dev/null || command -v mariadb &>/dev/null; then
        DB_TYPE="mysql"
        [[ "${VERBOSE_DETECTION}" == "true" ]] && log "INFO" "Detected MySQL/MariaDB client tools"
        extract_database_credentials
        return 0
    elif command -v psql &>/dev/null; then
        DB_TYPE="pgsql"
        [[ "${VERBOSE_DETECTION}" == "true" ]] && log "INFO" "Detected PostgreSQL client tools"
        extract_database_credentials
        return 0
    fi

    [[ "${VERBOSE_DETECTION}" == "true" ]] && log "WARNING" "No database detected or configured"
    DB_TYPE="none"
}

extract_database_credentials ()
{
    [[ -n "${DB_CREDENTIALS_EXTRACTED}" ]] && return 0

    if [[ -f "${XWIKI_INSTALL_DIR}/WEB-INF/hibernate.cfg.xml" ]]; then
        local hibernate_cfg="${XWIKI_INSTALL_DIR}/WEB-INF/hibernate.cfg.xml"

        if [[ "${DB_TYPE}" == "mysql" ]]; then
            if [[ -z "${MYSQL_USER}" ]] || [[ "${MYSQL_USER}" == "root" ]]; then
                MYSQL_USER=$(grep -v '<!--' "${hibernate_cfg}" | grep 'hibernate.connection.username' | grep -oP '>\K[^<]+' | head -n1)
                [[ -z "${MYSQL_USER}" ]] && MYSQL_USER="root"
            fi
            if [[ -z "${MYSQL_PASSWORD}" ]]; then
                MYSQL_PASSWORD=$(grep -v '<!--' "${hibernate_cfg}" | grep 'hibernate.connection.password' | grep -oP '>\K[^<]+' | head -n1)
            fi

            local jdbc_url=$(grep -v '<!--' "${hibernate_cfg}" | grep 'hibernate.connection.url' | grep -oP '>\K[^<]+' | head -n1)
            if [[ -n "${jdbc_url}" ]]; then
                if [[ -z "${MYSQL_HOST}" ]] || [[ "${MYSQL_HOST}" == "localhost" ]]; then
                    MYSQL_HOST=$(echo "${jdbc_url}" | sed -n 's|.*//\([^:/]*\).*|\1|p')
                    [[ -z "${MYSQL_HOST}" ]] && MYSQL_HOST="localhost"
                fi

                local db_name=$(echo "${jdbc_url}" | sed -n 's|.*/\([^/?]*\).*|\1|p')
                [[ -n "${db_name}" ]] && MYSQL_DATABASE="${db_name}"
            fi

        elif [[ "${DB_TYPE}" == "pgsql" ]]; then
            if [[ -z "${PGSQL_USER}" ]] || [[ "${PGSQL_USER}" == "postgres" ]]; then
                PGSQL_USER=$(grep -v '<!--' "${hibernate_cfg}" | grep 'hibernate.connection.username' | grep -oP '>\K[^<]+' | head -n1)
                [[ -z "${PGSQL_USER}" ]] && PGSQL_USER="postgres"
            fi
            if [[ -z "${PGSQL_PASSWORD}" ]]; then
                PGSQL_PASSWORD=$(grep -v '<!--' "${hibernate_cfg}" | grep 'hibernate.connection.password' | grep -oP '>\K[^<]+' | head -n1)
            fi

            local jdbc_url=$(grep -v '<!--' "${hibernate_cfg}" | grep 'hibernate.connection.url' | grep -oP '>\K[^<]+' | head -n1)
            if [[ -n "${jdbc_url}" ]]; then
                if [[ -z "${PGSQL_HOST}" ]] || [[ "${PGSQL_HOST}" == "localhost" ]]; then
                    PGSQL_HOST=$(echo "${jdbc_url}" | sed -n 's|.*//\([^:/]*\).*|\1|p')
                    [[ -z "${PGSQL_HOST}" ]] && PGSQL_HOST="localhost"
                fi
                if [[ -z "${PGSQL_DATABASE}" ]] || [[ "${PGSQL_DATABASE}" == "xwiki" ]]; then
                    PGSQL_DATABASE=$(echo "${jdbc_url}" | sed -n 's|.*/\([^/?]*\).*|\1|p')
                    [[ -z "${PGSQL_DATABASE}" ]] && PGSQL_DATABASE="xwiki"
                fi
            fi
        fi
    fi

    DB_CREDENTIALS_EXTRACTED="true"
    export MYSQL_USER MYSQL_PASSWORD MYSQL_HOST MYSQL_DATABASE
    export PGSQL_USER PGSQL_PASSWORD PGSQL_HOST PGSQL_DATABASE
}

get_container_pid ()
{
    local pid=""

    case "${CONTAINER_TYPE}" in
        "jetty")
            if [[ -f "${LOCK_FILE}" ]] && [[ -s "${LOCK_FILE}" ]]; then
                pid=$(cat "${LOCK_FILE}" 2>/dev/null)
                if [[ -n "${pid}" ]] && ! kill -0 "${pid}" 2>/dev/null; then
                    pid=""
                fi
            fi

            if [[ -z "${pid}" ]]; then
                pid=$(pgrep -f "start_xwiki.sh" | head -n 1)
            fi
            ;;

        "tomcat")
            if [[ -f "${CATALINA_PID}" ]] && [[ -s "${CATALINA_PID}" ]]; then
                pid=$(cat "${CATALINA_PID}" 2>/dev/null)
                if [[ -n "${pid}" ]] && ! kill -0 "${pid}" 2>/dev/null; then
                    pid=""
                fi
            fi

            if [[ -z "${pid}" ]]; then
                pid=$(pgrep -f "catalina" | head -n 1)
            fi
            ;;
    esac

    echo "${pid}"
}

is_container_running ()
{
    if systemctl is-active --quiet "${SERVICE_NAME}" 2>/dev/null; then
        return 0
    else
        local pid=$(get_container_pid)
        [[ -n "${pid}" ]] && return 0
        return 1
    fi
}

setup_systemd_override ()
{
    if [[ ! -d "/etc/systemd/system" ]]; then
        log "ERROR" "systemd not available"
        return 1
    fi

    local override_dir="/etc/systemd/system/${SERVICE_NAME}.d"
    local override_file="${override_dir}/xinit.conf"

    log "INFO" "Creating systemd override for ${SERVICE_NAME}..."
    mkdir -p "${override_dir}"

    case "${CONTAINER_TYPE}" in
        "jetty")
            cat > "${override_file}" <<EOF
[Service]
# Xinit managed environment configuration
Environment="XWIKI_OPTS=${XWIKI_OPTS:--Xms${MEM_START:-1024m} -Xmx${MEM_MAX:-2048m}}"
Environment="JETTY_PORT=${JETTY_PORT:-8080}"
Environment="JETTY_STOP_PORT=${JETTY_STOP_PORT:-8079}"

RestartSec=10s
TimeoutStopSec=120s

# Xinit runtime directory
ReadWritePaths=/var/run/xinit
EOF
            ;;
        "tomcat")
            cat > "${override_file}" <<EOF
[Service]
# Xinit managed environment configuration
Environment="JAVA_OPTS=${JAVA_OPTS}"
Environment="CATALINA_OPTS=${CATALINA_OPTS:--server -Xms${MEM_START:-1024m} -Xmx${MEM_MAX:-2048m}}"
Environment="CATALINA_PID=${CATALINA_PID}"

RestartSec=10s
TimeoutStopSec=120s

# Writable paths for Tomcat and XWiki
ReadWritePaths=/var/lib/xwiki/data
ReadWritePaths=${CONTAINER_BASE}
ReadWritePaths=${LOG_DIR}
ReadWritePaths=/var/run/xinit
EOF
            ;;
    esac

    # Append systemd hardening directives if enabled
    if [[ "${SYSTEMD_HARDENING}" == "yes" ]]; then
        local hardening_file="${LIB_DIR}/systemd-hardening.conf"
        if [[ -f "${hardening_file}" ]]; then
            cat "${hardening_file}" >> "${override_file}"
            log "INFO" "Systemd hardening enabled (SYSTEMD_HARDENING=yes)"
        else
            log "ERROR" "Hardening file not found: ${hardening_file}"
        fi
    else
        log "INFO" "Systemd hardening disabled (SYSTEMD_HARDENING=${SYSTEMD_HARDENING})"
    fi

    chmod 644 "${override_file}"
    systemctl daemon-reload

    log "INFO" "Systemd override created at ${override_file}"
    log "INFO" "Run 'systemctl daemon-reload' if you edit it manually"
}

start_container ()
{
    log "INFO" "Starting Container (${CONTAINER_TYPE} ${CONTAINER_VERSION})..."

    local delegated_to_systemd=false

    if [[ -z "${LAUNCHED_BY_SYSTEMD}" ]]; then
        if systemctl list-unit-files | grep -q "^${SERVICE_NAME}"; then
            if [[ ! -f "/etc/systemd/system/${SERVICE_NAME}.d/xinit.conf" ]] && [[ -n "${XWIKI_OPTS}" || -n "${MEM_START}" || -n "${MEM_MAX}" ]]; then
                log "WARNING" "Memory/JVM settings configured but systemd override not created"
                log "WARNING" "Run 'xinit setup-systemd' to apply your configuration"
            fi
            log "INFO" "Delegating to systemd: ${SERVICE_NAME}"
            systemctl start "${SERVICE_NAME}"
            delegated_to_systemd=true
        fi
    fi

    # OpenOffice management runs regardless of systemd delegation,
    # since Debian package service units call start_xwiki.sh/catalina.sh
    # directly and never invoke xinit start.
    if [[ ${OO_CHECK} -eq 1 ]] && [[ ${OO_SERVER_TYPE} -eq 0 ]]; then
        stop_openoffice
    fi
    if [[ ${OO_CHECK} -eq 1 ]] && [[ ${OO_SERVER_TYPE} -eq 1 ]]; then
        start_openoffice
    fi

    if [[ "${delegated_to_systemd}" == "false" ]]; then
        if is_container_running; then
            log "WARNING" "Container already running"
            return 0
        fi

        case "${CONTAINER_TYPE}" in
            "jetty")
                start_jetty
                ;;
            "tomcat")
                start_tomcat
                ;;
        esac
    fi

    if [[ -n "${MAKE_FIRST_REQUEST}" ]] && [[ "${MAKE_FIRST_REQUEST}" != "no" ]]; then
        log "INFO" "Waiting for container to be ready..."
        sleep ${FIRST_REQUEST_SLEEP_TIME}

        log "INFO" "Making first request(s)..."

        if [[ "${MAKE_FIRST_REQUEST}" == "yes" ]]; then
            check_http 1
        else
            for url in $(echo "${MAKE_FIRST_REQUEST}" | tr ',' '\n'); do
                log "INFO" "Requesting ${url}..."
                OLD_URL="${CHECK_HTTP_URL}"
                CHECK_HTTP_URL="${url}"
                check_http 1
                CHECK_HTTP_URL="${OLD_URL}"
            done
        fi
    fi

    return 0
}

start_jetty ()
{
    log "INFO" "Starting Jetty..."

    export XWIKI_OPTS="${XWIKI_OPTS:--Xms${MEM_START:-1024m} -Xmx${MEM_MAX:-2048m}}"
    export JETTY_PORT="${JETTY_PORT:-8080}"
    export JETTY_STOP_PORT="${JETTY_STOP_PORT:-8079}"
    export JAVA_HOME

    if [[ "${JVM_DEBUG}" == "yes" ]]; then
        export DEBUG=true
        export JETTY_DEBUG_PORT="${JVM_DEBUG_PORT:-5005}"
    fi

    if [[ -n "${JVM_AGENTPATH}" ]]; then
        XWIKI_OPTS="-agentpath:${JVM_AGENTPATH} ${XWIKI_OPTS}"
    fi

    if [[ ${UID} -eq 0 ]]; then
        su "${CONTAINER_USER}" -c "bash ${START_SCRIPT} --noninteractive"
    else
        bash "${START_SCRIPT}" --noninteractive
    fi
}

start_tomcat ()
{
    log "INFO" "Starting Tomcat..."

    if [[ "${CLEAN_TEMP_ON_STARTUP}" == "1" ]]; then
        log "INFO" "Cleaning temp folder..."
        rm -rf "${CONTAINER_BASE}"/temp/* 2>/dev/null || true
    fi

    if [[ -f "${LOG_DIR}/catalina.out" ]]; then
        LOG_SIZE=$(stat -c%s "${LOG_DIR}/catalina.out" 2>/dev/null || echo "0")
        LOG_ROTATE_SIZE="${LOG_ROTATE_SIZE:-10485760}"
        if [[ ${LOG_SIZE} -gt ${LOG_ROTATE_SIZE} ]]; then
            log "INFO" "Rotating catalina.out (${LOG_SIZE} bytes)..."
            mv "${LOG_DIR}/catalina.out" "${LOG_DIR}/catalina.out.$(date +%Y%m%d-%H%M%S)"
            ls -t "${LOG_DIR}"/catalina.out.* 2>/dev/null | tail -n +11 | xargs rm -f 2>/dev/null || true
        fi
    fi

    [[ -e "${CATALINA_PID}" ]] && rm -f "${CATALINA_PID}"

    export CATALINA_HOME="${CONTAINER_HOME}"
    export CATALINA_BASE="${CONTAINER_BASE}"
    export CATALINA_PID
    export JAVA_HOME
    export CATALINA_OPTS="${CATALINA_OPTS:--server -Xms${MEM_START:-1024m} -Xmx${MEM_MAX:-2048m} -Dfile.encoding=utf-8 -Djava.awt.headless=true}"
    export JAVA_OPTS="${JAVA_OPTS:-}"

    if [[ "${JVM_DEBUG}" == "yes" ]]; then
        CATALINA_OPTS="${CATALINA_OPTS} ${JVM_DEBUG_OPTS}"
    fi

    if [[ -n "${JVM_AGENTPATH}" ]]; then
        JAVA_OPTS="-agentpath:${JVM_AGENTPATH} ${JAVA_OPTS}"
    fi

    if [[ ${UID} -eq 0 ]]; then
        su "${CONTAINER_USER}" -c "${CONTAINER_HOME}/bin/catalina.sh start"
    else
        "${CONTAINER_HOME}/bin/catalina.sh" start
    fi
}

stop_container ()
{
    log "INFO" "Stopping Container (${CONTAINER_TYPE})..."

    if [[ -z "${LAUNCHED_BY_SYSTEMD}" ]]; then
        if systemctl list-unit-files | grep -q "^${SERVICE_NAME}"; then
            log "INFO" "Delegating to systemd: ${SERVICE_NAME}"
            systemctl stop "${SERVICE_NAME}"
            return $?
        fi
    fi

    case "${CONTAINER_TYPE}" in
        "jetty")
            stop_jetty
            ;;
        "tomcat")
            stop_tomcat
            ;;
    esac

    sleep 2

    local pid=$(get_container_pid)
    if [[ -n "${pid}" ]]; then
        log "WARNING" "Process still running, killing forcefully..."
        kill -9 "${pid}" 2>/dev/null
        sleep 1
    fi

    if [[ "${CONTAINER_TYPE}" == "tomcat" ]] && [[ -e "${CATALINA_PID}" ]]; then
        rm -f "${CATALINA_PID}"
    fi

    if [[ "${CONTAINER_TYPE}" == "jetty" ]] && [[ -f "${LOCK_FILE}" ]]; then
        rm -f "${LOCK_FILE}"
    fi

    if [[ ${OO_CHECK} -eq 1 ]] && [[ ${OO_SERVER_TYPE} -eq 0 ]]; then
        stop_openoffice
    fi
}

stop_jetty ()
{
    log "INFO" "Stopping Jetty..."

    if [[ ${UID} -eq 0 ]]; then
        su "${CONTAINER_USER}" -c "bash ${STOP_SCRIPT}"
    else
        bash "${STOP_SCRIPT}"
    fi
}

stop_tomcat ()
{
    log "INFO" "Stopping Tomcat..."

    if [[ ${UID} -eq 0 ]]; then
        su "${CONTAINER_USER}" -c "${CONTAINER_HOME}/bin/catalina.sh stop"
    else
        "${CONTAINER_HOME}/bin/catalina.sh" stop
    fi
}

restart_container ()
{
    local manual_restart=false

    if [[ -z "${LAUNCHED_BY_SYSTEMD}" ]] && [[ ${CHECK_PROC_RESTART} != "true" ]] && [[ ${CHECK_HTTP_RESTART} != "true" ]]; then
        manual_restart=true
    fi

    log "INFO" "Restarting Container (${CONTAINER_TYPE} ${CONTAINER_VERSION})..."

    KEEP_MAINTENANCE=0
    if [[ -f ${VAR_DIR}/maintenance ]]; then
        log "WARNING" "Maintenance mode already enabled. Delete ${VAR_DIR}/maintenance manually to disable."
        KEEP_MAINTENANCE=1
    elif [[ ${MAINTENANCE_ON_RESTARTS} == 1 ]]; then
        log "INFO" "Enabling maintenance mode for ${MAINTENANCE_TIME} seconds"
        mkdir -p "${VAR_DIR}"
        echo > "${VAR_DIR}/maintenance"
    fi

    if systemctl list-unit-files | grep -q "^${SERVICE_NAME}"; then
        if [[ ${UID} -eq 0 ]]; then
            systemctl stop "${SERVICE_NAME}"
            sleep 3
            systemctl start "${SERVICE_NAME}"
        else
            local pid=$(get_container_pid)
            if [[ -n "${pid}" ]]; then
                log "INFO" "Non-root: Killing process ${pid} to trigger systemd restart..."
                kill -9 "${pid}"
            else
                log "WARNING" "Process not found, attempting systemctl start..."
                systemctl start "${SERVICE_NAME}" || log "ERROR" "Failed to start service"
            fi
        fi
    else
        stop_container
        sleep 2
        start_container
        return $?
    fi

    if [[ ${MAINTENANCE_ON_RESTARTS} == 1 ]] && [[ ${KEEP_MAINTENANCE} != 1 ]]; then
        trap 'rm -f "${VAR_DIR}/maintenance" 2>/dev/null' SIGINT SIGQUIT SIGTERM TERM
        (
            sleep "${MAINTENANCE_TIME:-600}"
            rm -f "${VAR_DIR}/maintenance"
        ) &>/dev/null &
        trap - SIGINT SIGQUIT SIGTERM TERM
    fi

    if [[ -n "${MAKE_FIRST_REQUEST}" ]] && [[ "${MAKE_FIRST_REQUEST}" != "no" ]]; then
        log "INFO" "Waiting for container to be ready..."
        sleep 30

        log "INFO" "Making first request(s) after restart..."

        if [[ "${MAKE_FIRST_REQUEST}" == "yes" ]]; then
            check_http 1
        else
            for url in $(echo "${MAKE_FIRST_REQUEST}" | tr ',' '\n'); do
                log "INFO" "Requesting ${url}..."
                OLD_URL="${CHECK_HTTP_URL}"
                CHECK_HTTP_URL="${url}"
                check_http 1
                CHECK_HTTP_URL="${OLD_URL}"
            done
        fi
    fi
}

maintenance_reminder ()
{
        if [[ ${MAINTENANCE_REMINDER} == "1" ]]; then
                if [[ -f ${VAR_DIR}/maintenance ]]; then
                        if [[ ! -f ${VAR_DIR}/maintenance_lastmail_timestamp ]]; then
                                date +%s > "${VAR_DIR}"/maintenance_lastmail_timestamp
                        else
                                OLD_TIMESTAMP=$(cat "${VAR_DIR}"/maintenance_lastmail_timestamp)
                                DIFF=$(($(date +%s)-OLD_TIMESTAMP))
                                if [[ ${DIFF} -gt ${MAINTENANCE_REMINDER_PERIOD} ]]; then
                                        date +%s > "${VAR_DIR}"/maintenance_lastmail_timestamp
					echo "Hello! This is a reminder that maintenance mode on $(hostname)" > "${ATTACHE_FILE}"
					echo "is currently enabled. This means that the wiki won't automatically restart in case" >> "${ATTACHE_FILE}"
					echo "it crashes. Please remember to disable this maintenance mode once done with work on it." >> "${ATTACHE_FILE}"
					echo "Thank you!" >> "${ATTACHE_FILE}"
					send_Mail "Maintenance mode Reminder"
                                fi
                        fi
                else
                        rm -rf "${VAR_DIR}"/maintenance_lastmail_timestamp
                fi
        fi
}

check_proc ()
{
    echo -n "Checking Process (${CONTAINER_TYPE} ${CONTAINER_VERSION}) ... "

    CHECK_PROC_RESTART="true"

    if [[ ${PROCESS_CHECK} != yes ]]; then
        log "WARNING" "Process check disabled. Set PROCESS_CHECK=yes to enable."
        exit 1
    fi

    if is_container_running; then
        echo "OK"
        return 0
    else
        echo "FAILED"
        log "CRITICAL" "Container not running! Service: ${SERVICE_NAME}"
        if [[ "$1" -ne 1 ]] && [[ ! -f ${VAR_DIR}/maintenance ]]; then
            send_Notification "Container ${CONTAINER_TYPE} (${SERVICE_NAME}) is not running!"
            restart_container
        fi
        return 1
    fi
}

check_http ()
{

	echo "Checking wiki availability..."

	maintenance_reminder

	if [[ ${CHECK_HTTP} != yes && "${FORCE}" != 'force' ]]; then

		log "WARNING" "Check wiki availability functionality is not enabled. Please set CHECK_HTTP=yes in xinit.cfg file to enable it or use the force parameter. Bye Bye!"
		exit 1

	fi

	if [[ -z ${CHECK_HTTP_URL} ]]; then
		log "ERROR" "No URL was specified to check wiki availability. Please see CHECK_HTTP_URL parameter in xinit configuration."
		exit 1
	fi

    CHECK_HTTP_RESTART="true"

	log "INFO" "URL: ${CHECK_HTTP_URL}"
	cat /dev/null > "${REQUEST_ERROR_OUTPUT}"

	if [[ ${USE_BASIC_AUTH} == yes ]]; then

		RESPONSE_CODE="$(curl --write-out '%{http_code}' --digest --location-trusted --insecure -u "${HTACCESS_USERNAME}:${HTACCESS_PASSWORD}" --max-time "${CHECK_HTTP_TIMEOUT}" --retry "${CHECK_HTTP_TRIES}" --retry-delay "${CHECK_HTTP_WAITRETRY}" --silent --show-error --output /dev/null "${CHECK_HTTP_URL}" 2> "${REQUEST_ERROR_OUTPUT}")"
		EXIT_CODE="$?"

	elif [[ ${USE_BASIC_AUTH} == no ]]; then

		RESPONSE_CODE="$(curl --write-out '%{http_code}' --digest --location-trusted --insecure --max-time "${CHECK_HTTP_TIMEOUT}" --retry "${CHECK_HTTP_TRIES}" --retry-delay "${CHECK_HTTP_WAITRETRY}" --silent --show-error --output /dev/null "${CHECK_HTTP_URL}" 2> "${REQUEST_ERROR_OUTPUT}")"
		EXIT_CODE="$?"
	fi

	# DNS USE
	if [[ ${EXIT_CODE} -eq 6 ]]; then
		if [[ ${USE_DNS} == yes ]]; then
			log "WARNING" "DNS Problem. Unable to resolve domain name for ${CHECK_HTTP_URL}"
			send_Notification "DNS Problem. Unable to resolve domain name!"
			exit 1
		fi
	fi

	# Check response code
	RESPONSE_CODE_MATCH=0
	for TEST_RESPONSE_CODE in $(echo "${EXPECT_HTTP_RESPONSE_CODE}" | tr ',' '\n')
	do
		if [[ ${TEST_RESPONSE_CODE} -eq ${RESPONSE_CODE} ]]; then
			RESPONSE_CODE_MATCH=1
		fi
	done
	if [[ ${RESPONSE_CODE_MATCH} -ne 1 ]]; then

        log "CRITICAL" "wiki is NOT responding! Response code: ${RESPONSE_CODE} Expect Code: ${EXPECT_HTTP_RESPONSE_CODE} Exit Code: ${EXIT_CODE} URL: ${CHECK_HTTP_URL}"

		# If test-http
		if [[ $1 -ne 1 ]] && [[ ! -f ${VAR_DIR}/maintenance ]]; then
			send_Notification "wiki is NOT responding! Response code: ${RESPONSE_CODE} Expect Code: ${EXPECT_HTTP_RESPONSE_CODE} Exit Code: ${EXIT_CODE} URL: ${CHECK_HTTP_URL}"
			restart_container
		fi
	else
			log "INFO" "wiki is available! Response code: ${RESPONSE_CODE} Expect Code: ${EXPECT_HTTP_RESPONSE_CODE} Exit Code: ${EXIT_CODE}"
	fi

}

cronjob ()
{
    local action="${1:-toggle}"

    if [[ ${UID} -ne 0 ]]; then
        log "ERROR" "cronjob management requires root privileges"
        exit 1
    fi

    local cronjob_content=$(cat << EOF
*/1 * * * * root /usr/local/bin/xinit check-proc > /dev/null 2>&1
*/5 * * * * root /usr/local/bin/xinit check-http > /dev/null 2>&1
EOF
)

    case "${action}" in
        'on')
            echo "${cronjob_content}" > /etc/cron.d/xinit
            chmod 644 /etc/cron.d/xinit
            log "INFO" "Cronjobs enabled in /etc/cron.d/xinit"
            ;;
        'off')
            rm -f /etc/cron.d/xinit
            log "INFO" "Cronjobs disabled (removed /etc/cron.d/xinit)"
            ;;
        'check')
            if [[ -f /etc/cron.d/xinit ]]; then
                echo "Cronjobs are enabled in /etc/cron.d/xinit"
            else
                echo "Cronjobs are disabled"
            fi
            ;;
        '')
            if [[ -f /etc/cron.d/xinit ]]; then
                rm -f /etc/cron.d/xinit
                log "INFO" "Toggled: cronjobs disabled"
            else
                echo "${cronjob_content}" > /etc/cron.d/xinit
                chmod 644 /etc/cron.d/xinit
                log "INFO" "Toggled: cronjobs enabled"
            fi
            ;;
    esac
}

manage_timer ()
{
    local action="${1:-toggle}"

    if [[ ${UID} -ne 0 ]]; then
        log "ERROR" "Systemd timer management requires root privileges"
        exit 1
    fi

    if ! command -v systemctl &>/dev/null; then
        log "ERROR" "systemd not available, use 'cronjob' instead"
        exit 1
    fi

    case "${action}" in
        'on')
            if [[ ! -f /etc/systemd/system/xinit-monitor.service ]]; then
                log "INFO" "Creating xinit-monitor systemd units..."
                create_systemd_timer_units
            fi
            systemctl daemon-reload
            systemctl enable xinit-monitor.timer
            systemctl start xinit-monitor.timer
            log "INFO" "Systemd timer enabled"
            ;;
        'off')
            systemctl stop xinit-monitor.timer 2>/dev/null || true
            systemctl disable xinit-monitor.timer 2>/dev/null || true
            log "INFO" "Systemd timer disabled"
            ;;
        'check')
            if systemctl is-active --quiet xinit-monitor.timer 2>/dev/null; then
                echo "Systemd timer is enabled and active"
                systemctl status xinit-monitor.timer --no-pager
            elif systemctl is-enabled --quiet xinit-monitor.timer 2>/dev/null; then
                echo "Systemd timer is enabled but not active"
            else
                echo "Systemd timer is disabled"
            fi
            ;;
        '')
            if systemctl is-active --quiet xinit-monitor.timer 2>/dev/null; then
                systemctl stop xinit-monitor.timer
                systemctl disable xinit-monitor.timer
                log "INFO" "Toggled: timer disabled"
            else
                if [[ ! -f /etc/systemd/system/xinit-monitor.service ]]; then
                    create_systemd_timer_units
                fi
                systemctl daemon-reload
                systemctl enable xinit-monitor.timer
                systemctl start xinit-monitor.timer
                log "INFO" "Toggled: timer enabled"
            fi
            ;;
    esac
}

create_systemd_timer_units ()
{
    log "INFO" "Creating systemd timer units..."

    cat > /etc/systemd/system/xinit-monitor.service <<'EOF'
[Unit]
Description=XWiki Monitoring Service (xinit)
After=xwiki.service tomcat10.service tomcat9.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/xinit check-proc
ExecStart=/usr/local/bin/xinit check-http
StandardOutput=journal
StandardError=journal
EOF

    cat > /etc/systemd/system/xinit-monitor.timer <<'EOF'
[Unit]
Description=XWiki Monitoring Timer (xinit)
Requires=xinit-monitor.service

[Timer]
OnBootSec=5min
OnUnitActiveSec=5min
AccuracySec=1min

[Install]
WantedBy=timers.target
EOF

    chmod 644 /etc/systemd/system/xinit-monitor.service
    chmod 644 /etc/systemd/system/xinit-monitor.timer

    log "INFO" "Created systemd timer units"
}

